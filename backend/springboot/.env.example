SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/potoquitos_saas
SPRING_DATASOURCE_USERNAME=potoquitos_saas
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
FLYWAY_ENABLED=false

