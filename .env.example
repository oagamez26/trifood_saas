POSTGRES_DB=potoquitos
POSTGRES_USER=potoquitos
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET_KEY=change-this-jwt-secret
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://potoquitos:REPLACE_ME@db:5432/potoquitos
ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_HOURS=8
PASSWORD_RESET_MINUTES=30
CORS_ALLOWED_ORIGINS=["http://localhost:8080"]
CATALOG_MEDIA_ROOT=/app/media/products
CATALOG_IMAGE_MAX_BYTES=5242880
VITE_API_URL=/api
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@potoquitos.local
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=superadmin@potoquitos.local
ADMIN_PASSWORD=use-a-strong-password-here
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
